[Unit]
Description=llama.cpp server - Nemotron-3-Nano-30B chat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
ExecStart=__RUN_SCRIPT__
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
OOMScoreAdjust=200

[Install]
WantedBy=multi-user.target
