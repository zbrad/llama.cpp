# toolkits/cu135.env -- CUDA 13.5 toolkit definition for tuned builds.
# Loaded by gpu_tuned_load_toolkit; do not execute. The file name is the
# toolkit id (CUDA_TAG). An optional toolkits/<variant>-cu135.env is sourced
# after this one and overrides any key where the stack differs per variant.
#
# Every value below was read from a real install, not assumed. Observed on
# geo-a-node-gb10-1 (aarch64, 2026-11-13):
#   /usr/local/cuda-13.5/bin/nvcc --version  -> release 13.5, V13.5.37
# TOOLKIT_NCCL_VERSION="none": NCCL for this toolkit comes from a pinned zbrad/nccl release (a
# tuned/nccl.pins entry, fetched with gpu_tuned_fetch_nccl_release), linked statically, the same
# policy as cu134. The node has libnccl2 2.32.6-1+cuda13.5 installed from apt, but it is not used
# by tuned builds; the zbrad/nccl cu135 branch is built from the same upstream release (v2.32.6-1).
# Every toolkit file must define this key (tests/test_common.sh checks it).
#
# Driver note: a cu135 build must ship SASS for its arch. PTX produced by a toolkit newer
# than 13.0 does not JIT on an R580 driver (zfleet nodes/gb10-driver-support.md).

TOOLKIT_ID="cu135"
TOOLKIT_CUDA_VER="13.5"
# Always the toolkit-versioned directory, never the unversioned /usr/local/cuda
# symlink (it points at whichever toolkit is newest, not the one pinned here).
TOOLKIT_CUDA_HOME="/usr/local/cuda-13.5"
# Must equal the "release X.Y" that nvcc prints.
TOOLKIT_NVCC_RELEASE="13.5"
TOOLKIT_NCCL_VERSION="none"
