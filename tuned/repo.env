# tuned/repo.env -- llama.cpp-specific settings for tuned builds. Sourced by
# tuned/env.sh after the shared device and toolkit definitions (tuned/common-data,
# from zbrad/tuned-common). Tracked, so a release is reproducible.
#
# This file may only ADD repo-specific settings. Changing any shared key
# (GPU_TUNED_*, CUDA_*, TOOLKIT_*) is a loud error from env.sh.
#
# Plain assignment on purpose: this file is sourced inside a function, where
# `declare` would make the variable local and lose it.

# CMake options for the release build. Read from the configured build/
# (CMakeCache.txt) and the build command in .claude/settings.local.json, 2026-10-09.
# The arch and compiler come from the shared files (release.sh adds them).
# GGML_CUDA_NCCL=ON links NCCL, which makes the toolkit's TOOLKIT_NCCL_VERSION
# pin matter: the libnccl2 that package.sh bundles must be built for that toolkit.
LLAMA_TUNED_CMAKE_FLAGS=(
    -DCMAKE_BUILD_TYPE=Release
    -DGGML_CUDA=ON
    -DGGML_CUDA_FA=ON
    -DGGML_CUDA_GRAPHS=ON
    -DGGML_CUDA_NCCL=ON
    -DGGML_CUDA_COMPRESSION_MODE=size
)
